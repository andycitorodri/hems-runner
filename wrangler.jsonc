{
  // HEMS Runner — Worker con assets estáticos.
  // Deploy:  npx wrangler deploy
  // Sustituye al drag & drop de index.html en el dashboard (necesario desde
  // que el juego carga assets/models/*.glb por ruta relativa).
  "name": "app",
  "compatibility_date": "2026-04-01",
  // Dominio propio (zona jornadaimpacte.com, misma cuenta). Cloudflare crea
  // el DNS y el certificado en el deploy. app.hems.workers.dev sigue activo.
  "workers_dev": true,
  "routes": [
    { "pattern": "hems.jornadaimpacte.com", "custom_domain": true }
  ],
  // Ranking en servidor: worker/index.js atiende /api/* y /admin; el resto son assets.
  "main": "worker/index.js",
  "assets": {
    "directory": "./",
    "binding": "ASSETS"
  },
  "d1_databases": [
    { "binding": "DB", "database_name": "hems-leaderboard", "database_id": "60648bad-da4b-4c23-b71d-215aef5de7f9" }
  ]
  // Secreto ADMIN_TOKEN (panel /admin?token=...): `npx wrangler secret put ADMIN_TOKEN`
}
